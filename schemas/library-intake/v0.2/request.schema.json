{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua-project.github.io/schemas/library-intake/v0.2/request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "requestId", "correlationId", "kind", "method", "commandId", "params"],
  "properties": {
    "contractVersion": {"const": "0.1"}, "requestId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1}, "kind": {"const": "command"},
    "method": {"const": "library.importPaths"}, "commandId": {"type": "string", "minLength": 1},
    "params": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourcePaths"],
      "properties": {
        "schemaVersion": {"const": "0.2"},
        "sourcePaths": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\]+\\\\[^\\\\]+|/)", "not": {"pattern": "\u0000"}}},
        "autoGenerate": {"type": "boolean"}
      }
    }
  }
}
