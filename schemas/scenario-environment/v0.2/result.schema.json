{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/schemas/scenario-environment/v0.2/result.schema.json",
  "$defs": {
    "platformId": {
      "enum": [
        "vrchat",
        "chilloutvr",
        "reborn"
      ]
    },
    "deviceId": {
      "enum": [
        "pc",
        "pico",
        "quest",
        "steam-frame",
        "vive-standalone",
        "vive-wired",
        "index",
        "psvr2",
        "bigscreen",
        "pimax",
        "varjo",
        "meganex",
        "rift-s",
        "wmr",
        "other-headset"
      ]
    },
    "connectionId": {
      "enum": [
        "pico-connect",
        "standalone",
        "quest-link",
        "steam-link",
        "virtual-desktop",
        "alvr",
        "steam-frame",
        "vive-hub",
        "steamvr-direct",
        "psvr2-app",
        "bigscreen-driver",
        "pimax-play",
        "varjo-base",
        "meganex-configurator",
        "rift-app",
        "wmr-steamvr",
        "steamvr-other"
      ]
    },
    "engine": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "route" },
            "route": { "enum": ["desktop_play", "pico_pcvr"] }
          },
          "required": ["kind", "route"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "tool" },
            "toolId": { "$ref": "#/$defs/platformId" }
          },
          "required": ["kind", "toolId"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "headset" }
          },
          "required": ["kind"]
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "vua.scenario-environment/v0.2"
        },
        "platforms": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/platformId" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "name"]
          }
        },
        "devices": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/deviceId" },
              "name": { "type": "string" },
              "connections": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/connectionId" }
              },
              "store": { "enum": ["pico", "meta", "viveport"] },
              "other": { "const": true }
            },
            "required": ["id", "name", "connections"]
          }
        },
        "connections": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/connectionId" },
              "name": { "type": "string" },
              "component": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://\\S+$"
              }
            },
            "required": ["id", "name", "component", "url"]
          }
        }
      },
      "required": ["schemaVersion", "platforms", "devices", "connections"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "vua.scenario-environment/v0.2"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "$ref": "#/$defs/platformId" },
            "device": { "$ref": "#/$defs/deviceId" },
            "connection": {
              "oneOf": [
                { "$ref": "#/$defs/connectionId" },
                { "type": "null" }
              ]
            }
          },
          "required": ["platform", "device", "connection"]
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "steam",
                  "steam-sign-in",
                  "platform",
                  "connection-pc",
                  "connection-headset",
                  "launch",
                  "store-install",
                  "store-launch"
                ]
              },
              "actor": { "enum": ["vua", "open", "player"] },
              "title": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 },
              "expectedResult": { "type": "string", "minLength": 1 },
              "automatic": { "type": "boolean" },
              "verification": { "type": "string", "minLength": 1 },
              "onFailure": { "type": "string", "minLength": 1 }
            },
            "required": [
              "id",
              "actor",
              "title",
              "explanation",
              "expectedResult",
              "automatic",
              "verification",
              "onFailure"
            ]
          }
        },
        "performed": { "const": "sop_only" },
        "nextAction": { "enum": ["check_environment", "follow_sop"] },
        "sopVersions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "device": { "type": "string", "minLength": 1 },
            "connection": { "type": ["string", "null"], "minLength": 1 }
          },
          "required": ["platform", "device", "connection"]
        },
        "lastVerification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "environment": { "type": "string", "minLength": 1 },
            "softwareVersions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["date", "environment", "softwareVersions"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https://\\S+$" }
            },
            "required": ["label", "url"]
          }
        }
      },
      "required": [
        "schemaVersion",
        "selection",
        "engine",
        "requirements",
        "steps",
        "performed",
        "nextAction",
        "sopVersions",
        "lastVerification",
        "sources"
      ]
    }
  ]
}
