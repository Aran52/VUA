{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/library-records/v0.2/request.schema.json",
  "type": "object", "additionalProperties": false, "required": ["method", "params"],
  "properties": {
    "method": { "const": "library.removeCards" },
    "params": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "targets"],
      "properties": {
        "schemaVersion": { "const": "0.2" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "id"],
          "properties": { "kind": { "enum": ["entry", "product"] }, "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" } },
          "allOf": [{ "if": { "properties": { "kind": { "const": "product" } } }, "then": { "properties": { "id": { "pattern": "^booth:[0-9]+$" } } } }]
        } }
      }
    }
  }
}
