{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/amf-production-flow/v0.1/status.schema.json",
  "title": "AMF material-first run status v0.1 (Candidate)",
  "description": "The status fields of an amf.production.get result: phase, steps with their times, usual step durations on this computer and the progress of the running step. The protocol describes the other fields of the result.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "phase",
    "taskId",
    "steps",
    "usualDurations",
    "progress"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,100}$"
    },
    "phase": {
      "enum": [
        "preparing",
        "inspecting",
        "ready",
        "assembling",
        "restoring",
        "succeeded",
        "failed",
        "cancelled",
        "stopped",
        "inspect_required"
      ]
    },
    "taskId": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "state",
          "detail",
          "startedAt",
          "endedAt"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/stepKey"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "succeeded",
              "failed",
              "stopped",
              "interrupted"
            ]
          },
          "detail": {
            "type": "string"
          },
          "startedAt": {
            "oneOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "endedAt": {
            "oneOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "usualDurations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stepKey"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "progress": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "name",
            "startedAt",
            "elapsedSeconds",
            "usualSeconds"
          ],
          "properties": {
            "step": {
              "$ref": "#/$defs/stepKey"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "startedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "elapsedSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "usualSeconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "unity": {
              "$ref": "#/$defs/unity"
            }
          }
        }
      ]
    },
    "editorClose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenesSaved",
        "assetsSaved",
        "editorClosed",
        "schemaVersion",
        "runId",
        "closeId",
        "outcome",
        "reason",
        "detail"
      ],
      "properties": {
        "scenesSaved": {
          "type": "boolean"
        },
        "assetsSaved": {
          "type": "boolean"
        },
        "editorClosed": {
          "type": "boolean"
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,100}$"
        },
        "closeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,100}$"
        },
        "outcome": {
          "enum": [
            "saved",
            "failed"
          ]
        },
        "reason": {
          "enum": [
            "",
            "scene_save_failed",
            "asset_save_failed",
            "untitled_scene",
            "editor_busy",
            "expired",
            "cancelled",
            "save_failed",
            "timeout"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "saved"
          }
        }
      },
      "then": {
        "properties": {
          "scenesSaved": {
            "const": true
          },
          "assetsSaved": {
            "const": true
          },
          "reason": {
            "enum": [
              "",
              "timeout"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "stepKey": {
      "enum": [
        "project",
        "materials",
        "inspect",
        "reinspect",
        "snapshot",
        "assembly",
        "protect_current",
        "restore",
        "turntable",
        "upload",
        "sdk_fix",
        "face_tracking",
        "lighting",
        "editor_close",
        "texture_memory"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "unity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "lastActivityAt"
      ],
      "properties": {
        "stage": {
          "enum": [
            "starting",
            "license",
            "packages",
            "importing",
            "compiling",
            "bridge",
            "previews",
            "finishing",
            "fingerprint"
          ]
        },
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "lastActivityAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "result": {
          "if": {
            "type": "object"
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "textureMemory": {
                    "oneOf": [
                      {
                        "type": "array",
                        "maxItems": 0
                      },
                      {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "prefixItems": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "platform": {
                                "const": "pc"
                              },
                              "textures": {
                                "type": "array",
                                "maxItems": 2048,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "maxLength": 256,
                                      "minLength": 1
                                    },
                                    "path": {
                                      "type": "string",
                                      "maxLength": 4096
                                    },
                                    "width": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "height": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "format": {
                                      "type": "string",
                                      "maxLength": 64
                                    },
                                    "mipmap": {
                                      "type": "boolean"
                                    },
                                    "faces": {
                                      "enum": [
                                        1,
                                        6
                                      ]
                                    },
                                    "estimatedBytes": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    "known": {
                                      "type": "boolean"
                                    },
                                    "maxSize": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "editable": {
                                      "type": "boolean"
                                    },
                                    "reason": {
                                      "type": "string",
                                      "maxLength": 128
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "path",
                                    "width",
                                    "height",
                                    "format",
                                    "mipmap",
                                    "faces",
                                    "estimatedBytes",
                                    "known",
                                    "maxSize",
                                    "editable",
                                    "reason"
                                  ]
                                }
                              },
                              "totalBytes": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "complete": {
                                "type": "boolean"
                              },
                              "rank": {
                                "enum": [
                                  "excellent",
                                  "good",
                                  "medium",
                                  "poor",
                                  "very_poor",
                                  "unknown"
                                ]
                              }
                            },
                            "required": [
                              "platform",
                              "textures",
                              "totalBytes",
                              "complete",
                              "rank"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "platform": {
                                "const": "android"
                              },
                              "textures": {
                                "type": "array",
                                "maxItems": 2048,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "maxLength": 256,
                                      "minLength": 1
                                    },
                                    "path": {
                                      "type": "string",
                                      "maxLength": 4096
                                    },
                                    "width": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "height": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "format": {
                                      "type": "string",
                                      "maxLength": 64
                                    },
                                    "mipmap": {
                                      "type": "boolean"
                                    },
                                    "faces": {
                                      "enum": [
                                        1,
                                        6
                                      ]
                                    },
                                    "estimatedBytes": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    "known": {
                                      "type": "boolean"
                                    },
                                    "maxSize": {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 16384
                                    },
                                    "editable": {
                                      "type": "boolean"
                                    },
                                    "reason": {
                                      "type": "string",
                                      "maxLength": 128
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "path",
                                    "width",
                                    "height",
                                    "format",
                                    "mipmap",
                                    "faces",
                                    "estimatedBytes",
                                    "known",
                                    "maxSize",
                                    "editable",
                                    "reason"
                                  ]
                                }
                              },
                              "totalBytes": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "complete": {
                                "type": "boolean"
                              },
                              "rank": {
                                "enum": [
                                  "excellent",
                                  "good",
                                  "medium",
                                  "poor",
                                  "very_poor",
                                  "unknown"
                                ]
                              }
                            },
                            "required": [
                              "platform",
                              "textures",
                              "totalBytes",
                              "complete",
                              "rank"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
