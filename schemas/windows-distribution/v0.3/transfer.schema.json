{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VUA compressed component transfer manifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "platform",
    "arch",
    "component",
    "manifestSha256",
    "encoding",
    "pack",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.3"
    },
    "product": {
      "const": "VUA"
    },
    "platform": {
      "const": "windows"
    },
    "arch": {
      "const": "x64"
    },
    "component": {
      "enum": [
        "host",
        "amf"
      ]
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "encoding": {
      "enum": [
        "zstd",
        "gzip"
      ]
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "sources"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "compressedOffset",
          "compressedBytes",
          "compressedSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "compressedOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483648
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "compressedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
