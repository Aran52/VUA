            "unsupported",
            "not_public",
            "failed"
          ]
        },
        "decision": {
          "enum": [
            "conforms",
            "contact_licensor",
            "unknown",
            "nonconforming"
          ]
        },
        "blockingItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "maxItems": 20000
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required"
          },
          "maxItems": 20000
        },
        "advisories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "maxItems": 20000
        },
        "hasSpecialNote": {
          "type": "boolean"
        },
        "specialNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/special"
