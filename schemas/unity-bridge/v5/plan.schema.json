{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/unity-bridge/v5/plan.schema.json",
  "title": "AMF Bridge v5 request document (Candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "sources",
    "selection"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,100}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "role",
          "assetPaths"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          },
          "role": {
            "enum": [
              "auto",
              "avatar",
              "outfit",
              "dependency"
            ]
          },
          "assetPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))Assets/[^\\\\:\\u0000]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "selection": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "avatarPrefab",
            "outfits"
          ],
          "properties": {
            "avatarPrefab": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            },
            "outfits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceId",
                  "prefabPath",
                  "mode",
                  "bone",
                  "toggleName",
                  "active"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "prefabPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "mode": {
                    "enum": [
                      "merge_armature",
                      "attach_to_bone"
                    ]
                  },
                  "bone": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "toggleName": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[^\\u0000-\\u001f]*$"
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "fit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "objects"
                    ],
                    "properties": {
                      "objects": {
                        "type": "array",
                        "maxItems": 2048,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "path",
                            "localPosition",
                            "localRotation",
                            "localScale"
                          ],
                          "properties": {
                            "path": {
                              "type": "string",
                              "maxLength": 512
                            },
                            "localPosition": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "x",
                                "y",
                                "z"
                              ],
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "z": {
                                  "type": "number"
                                }
                              }
                            },
                            "localRotation": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "x",
                                "y",
                                "z",
                                "w"
                              ],
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "z": {
                                  "type": "number"
                                },
                                "w": {
                                  "type": "number"
                                }
                              }
                            },
                            "localScale": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "x",
                                "y",
                                "z"
                              ],
                              "properties": {
                                "x": {
                                  "type": "number"
                                },
                                "y": {
                                  "type": "number"
                                },
                                "z": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "applyTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avatarGlobalObjectId",
        "newAvatarKey",
        "writeSourceIds"
      ],
      "properties": {
        "avatarGlobalObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "newAvatarKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^recipe-[a-f0-9]{24}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "writeSourceIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          }
        }
      }
    },
    "faceTrackingPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "menuId",
        "avatarGlobalObjectId",
        "confirmTrustedCode"
      ],
      "properties": {
        "menuId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "avatarGlobalObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "confirmTrustedCode": {
          "const": true
        }
      }
    },
    "textureChanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))Assets/[^\\\\:\\u0000]+$"
          },
          "platform": {
            "enum": [
              "pc",
              "android"
            ]
          },
          "maxSize": {
            "enum": [
              32,
              64,
              128,
              256,
              512,
              1024,
              2048,
              4096,
              8192,
              16384
            ]
          },
          "format": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "required": [
          "path",
          "platform",
          "maxSize",
          "format"
        ]
      }
    },
    "outfitRemoval": {
      "$ref": "#/$defs/outfitRemoval"
    }
  },
  "$defs": {
    "outfitRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "avatarGlobalObjectId",
        "roots",
        "objects",
        "blockedReason"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "avatarGlobalObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "roots": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "globalObjectId"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "outfit",
                  "menu"
                ]
              },
              "globalObjectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]*$"
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "globalObjectId",
              "path",
              "typeName",
              "manual"
            ],
            "properties": {
              "globalObjectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]*$"
              },
              "path": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "typeName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]*$"
              },
              "manual": {
                "type": "boolean"
              }
            }
          }
        },
        "blockedReason": {
          "enum": [
            "",
            "ownership_invalid",
            "target_unverified",
            "contains_owned_object",
            "inventory_limit",
            "identity_invalid"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "blockedReason": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "roots": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "outfit"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              "objects": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
