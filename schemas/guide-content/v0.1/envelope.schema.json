{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/schemas/guide-content/v0.1/envelope.schema.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "payload",
    "signature"
  ]
}
