{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/terms/v0.1/request.schema.json",
  "title": "VN3 terms requests v0.1 (Candidate)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "kind",
        "params"
      ],
      "properties": {
        "method": {
          "const": "terms.getProduct"
        },
        "kind": {
          "const": "query"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "productId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "productId": {
              "type": "string",
              "pattern": "^booth:[1-9][0-9]{0,19}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "kind",
        "params"
      ],
      "properties": {
        "method": {
          "const": "terms.checkUse"
        },
        "kind": {
          "const": "query"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "presetId",
            "productIds"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "presetId": {
              "enum": [
                "vrchat_personal",
                "vtuber_individual",
                "vtuber_corporate",
                "game_development",
                "outfit_for_sale",
                "merchandise_publication",
                "adult_content"
              ]
            },
            "productIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^booth:[1-9][0-9]{0,19}$"
              },
              "maxItems": 500,
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "kind",
        "params"
      ],
      "properties": {
        "method": {
          "const": "terms.refreshProduct"
        },
        "kind": {
          "const": "command"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "productId"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "productId": {
              "type": "string",
              "pattern": "^booth:[1-9][0-9]{0,19}$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "kind",
        "params"
      ],
      "properties": {
        "method": {
          "const": "terms.refreshLibrary"
        },
        "kind": {
          "const": "command"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            }
          }
        }
      }
    }
  ]
}
