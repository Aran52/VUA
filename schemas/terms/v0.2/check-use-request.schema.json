{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/terms/v0.2/check-use-request.schema.json",
  "title": "TermsCheckUseRequestParamsV0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "presetId", "productIds"],
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "presetId": {
      "enum": [
        "vrchat_personal",
        "vtuber_individual",
        "vtuber_corporate",
        "game_development",
        "outfit_for_sale",
        "merchandise_publication",
        "adult_content",
        "phr_personal_avatar",
        "phr_object_head",
        "phr_shared_space"
      ]
    },
    "productIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^booth:[1-9][0-9]{0,19}$"
      }
    }
  }
}
