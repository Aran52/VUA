{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VUA installed payload pointer v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hostManifest",
    "amfManifest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "hostManifest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "amfManifest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
