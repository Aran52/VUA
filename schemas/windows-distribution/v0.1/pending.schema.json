{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VUA pending AMF update v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifest",
    "state",
    "requested"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "manifest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "interrupted",
        "staged"
      ]
    },
    "requested": {
      "type": "boolean"
    }
  }
}
