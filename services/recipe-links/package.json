    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vua/contracts": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
