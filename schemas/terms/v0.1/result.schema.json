              "type": "string",
              "maxLength": 2097152
            },
            {
              "type": "null"
            }
          ]
        },
        "specialNote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2097152
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "maxItems": 20000
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 24
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "parsed"
              }
            }
          },
          "then": {
            "properties": {
              "generatorVersion": {
                "enum": [
                  "1.10",
                  "1.11"
                ]
              },
              "vn3Version": {
                "const": "1.10"
              },
              "language": {
                "enum": [
                  "ja",
                  "en"
                ]
              },
              "items": {
                "minItems": 24,
                "maxItems": 24,
                "prefixItems": [
                  {
                    "properties": {
                      "item": {
