{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/terms/v0.2/check-use-result.schema.json",
  "title": "TermsUseCheckV0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "presetId", "products", "matchingProductIds", "combination"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "presetId": {
      "enum": [
        "vrchat_personal",
        "vtuber_individual",
        "vtuber_corporate",
        "game_development",
        "outfit_for_sale",
        "merchandise_publication",
        "adult_content",
        "phr_personal_avatar",
        "phr_object_head",
        "phr_shared_space"
      ]
    },
    "matchingProductIds": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^booth:[1-9][0-9]{0,19}$" }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/productUseDecision" }
    },
    "combination": { "$ref": "#/$defs/useDecision" }
  },
  "$defs": {
    "useDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blockingItems",
        "conditions",
        "advisories",
        "hasSpecialNote",
        "specialNotes",
        "platformRestrictionHint"
      ],
      "properties": {
        "decision": { "enum": ["conforms", "contact_licensor", "nonconforming", "unknown"] },
        "blockingItems": { "type": "array" },
        "conditions": { "type": "array" },
        "advisories": { "type": "array" },
        "hasSpecialNote": { "type": "boolean" },
        "specialNotes": { "type": "array" },
        "platformRestrictionHint": { "type": "boolean" }
      }
    },
    "productUseDecision": {
      "allOf": [
        { "$ref": "#/$defs/useDecision" },
        {
          "type": "object",
          "required": ["productId", "sourceState"],
          "properties": {
            "productId": { "type": "string", "pattern": "^booth:[1-9][0-9]{0,19}$" },
            "sourceState": { "type": "string" }
          }
        }
      ]
    }
  }
}
