{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VUA signed distribution metadata v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "payload",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.3"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4194304
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
