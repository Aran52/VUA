{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vua.local/schemas/library-view/v0.2/request.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params"
      ],
      "properties": {
        "method": {
          "const": "library.list"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.2"
            },
            "source": {
              "type": "string",
              "enum": [
                "all",
                "local",
                "imported",
                "bought",
                "gifts",
                "free_downloads"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "all",
                "downloaded",
                "cloud_only",
                "missing",
                "in_progress",
                "attention"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 1000
            },
            "availabilityStatus": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sourceCategory": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "descriptionLinksTo": {
              "type": "string",
              "pattern": "^booth:[0-9]+$"
            },
            "use": {
              "enum": [
                "vrchat_personal",
                "vtuber_individual",
                "vtuber_corporate",
                "game_development",
                "outfit_for_sale",
                "merchandise_publication",
                "adult_content"
              ]
            },
            "useMode": {
              "enum": [
                "available",
                "all"
              ]
            }
          },
          "dependentRequired": {
            "useMode": [
              "use"
            ]
          }
        }
      }
    }
  ]
}
