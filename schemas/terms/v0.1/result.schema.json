          "enum": [
            "between_users_only",
            "commercial_and_non_profit",
            "content_rating_required",
            "credit_preferred",
            "limited_publication_only",
            "modified_distinguishable",
            "non_profit_only",
            "private_use_exception",
            "private_use_only"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blockingItems",
        "conditions",
        "advisories",
        "hasSpecialNote",
        "specialNotes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "conforms",
            "contact_licensor",
            "unknown",
            "nonconforming"
          ]
        },
        "blockingItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "maxItems": 20000
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required"
          },
          "maxItems": 20000
        },
        "advisories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "maxItems": 20000
        },
        "hasSpecialNote": {
          "type": "boolean"
        },
        "specialNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/special"
          },
          "maxItems": 20000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hasSpecialNote": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "specialNotes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "specialNotes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "conforms"
              }
            }
          },
          "then": {
            "properties": {
              "blockingItems": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "blockingItems": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "productDecision": {
