{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vua.local/installer-tool/v0.1/request.schema.json",
  "title": "Official-installer tool launch and observation v0.1 Candidate",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "correlationId",
        "kind",
        "method",
        "params"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "query"
        },
        "method": {
          "const": "tools.observeInstaller"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolId"
          ],
          "properties": {
            "toolId": {
              "enum": [
                "slimevr",
                "vrct",
                "vrcx",
                "vrcs"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "correlationId",
        "kind",
        "method",
        "params",
        "commandId"
      ],
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "command"
        },
        "method": {
          "const": "tools.actInstaller"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolId",
            "action"
          ],
          "properties": {
            "toolId": {
              "enum": [
                "slimevr",
                "vrct",
                "vrcx",
                "vrcs"
              ]
            },
            "action": {
              "enum": [
                "start",
                "stop",
                "cancel"
              ]
            }
          }
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    }
  ]
}
