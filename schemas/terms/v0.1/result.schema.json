        "vn3Version",
        "language",
        "contentTitle",
        "licensor",
        "creditNotation",
        "hashtags",
        "agreementVersion",
        "specialNote",
        "warnings",
        "items"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parserVersion": {
          "const": "vn3-parser/1"
        },
        "status": {
          "enum": [
            "parsed",
            "unrecognized",
            "unsupported"
          ]
        },
        "generatorVersion": {
