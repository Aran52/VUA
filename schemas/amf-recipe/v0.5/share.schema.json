{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/amf-recipe/v0.5/share.schema.json",
  "title": "BOOTH Recipe sharing v0.5 (Candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "recipe",
    "sources"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.5"
    },
    "recipe": {
      "title": "AMF production Recipe v0.5 (Candidate)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "recipeId",
        "title",
        "editorVersion",
        "materials",
        "avatar",
        "outfits",
        "packages"
      ],
      "properties": {
        "formatVersion": {
          "const": "0.5"
        },
        "recipeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "editorVersion": {
          "enum": [
            "2022.3.22f1",
            "2022.3.22f1c1"
          ]
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "packageName",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "packageName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^/\\\\:\\u0000-\\u001f\\u007f-\\u009f]+\\.[uU][nN][iI][tT][yY][pP][aA][cC][kK][aA][gG][eE]$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "boothProductId": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              }
            }
          }
        },
        "avatar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "materialId",
            "prefabPath"
          ],
          "properties": {
            "materialId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            },
            "prefabPath": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^Assets/(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\:\\u0000])(?!.*//).+\\.prefab$"
            },
            "prefabGuid": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        },
        "outfits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "materialId",
              "prefabPath",
              "mode",
              "bone",
              "toggleName",
              "active"
            ],
            "properties": {
              "materialId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "prefabPath": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^Assets/(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\:\\u0000])(?!.*//).+\\.prefab$"
              },
              "mode": {
                "enum": [
                  "merge_armature",
                  "attach_to_bone"
                ]
              },
              "bone": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
              },
              "toggleName": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
              },
              "active": {
                "type": "boolean"
              },
              "prefabGuid": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            }
          }
        },
        "packages": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 64,
          "required": [
            "com.vrchat.avatars",
            "nadena.dev.modular-avatar"
          ],
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?=.*\\.)[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9.+-]{1,80}$"
          }
        },
        "adjustments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lighting",
            "sdkFixes"
          ],
          "properties": {
            "lighting": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "material",
                  "min",
                  "max",
                  "materialId"
                ],
                "properties": {
                  "material": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^Assets/(?![.]{1,2}(?:/|$))(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[\\\\:\\u0000])(?!.*//).+\\.mat$"
                  },
                  "min": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
                  },
                  "max": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
                  },
                  "materialId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  }
                }
              }
            },
            "sdkFixes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "pattern": "^[^\\u0000]+$"
              }
            },
            "fits": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "materialId",
                  "objects"
                ],
                "properties": {
                  "materialId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "objects": {
                    "type": "array",
                    "maxItems": 2048,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "localPosition",
                        "localRotation",
                        "localScale"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 512
                        },
                        "localPosition": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y",
                            "z"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "z": {
                              "type": "number"
                            }
                          }
                        },
                        "localRotation": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y",
                            "z",
                            "w"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "z": {
                              "type": "number"
                            },
                            "w": {
                              "type": "number"
                            }
                          }
                        },
                        "localScale": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y",
                            "z"
                          ],
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            },
                            "z": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boothProductId"
        ],
        "properties": {
          "boothProductId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "shopName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          }
        }
      },
      "minProperties": 1
    }
  }
}
