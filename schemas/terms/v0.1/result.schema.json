      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "processedProducts": {
          "type": "integer",
          "minimum": 0
        },
        "parsedDocuments": {
          "type": "integer",
          "minimum": 0
        },
        "problemDocuments": {
          "type": "integer",
          "minimum": 0
        },
        "cachedDocuments": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/detail"
    },
    {
      "$ref": "#/$defs/check"
    },
    {
      "$ref": "#/$defs/accepted"
    },
    {
      "$ref": "#/$defs/report"
    }
  ]
