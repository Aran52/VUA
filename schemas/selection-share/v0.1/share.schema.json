{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ph-r.com/vua/schemas/selection-share/v0.1/share.schema.json",
  "title": "Public BOOTH product selection v0.1 (Candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "formatVersion", "title", "products"],
  "properties": {
    "kind": { "const": "vua.selection" },
    "formatVersion": { "const": "0.1" },
    "title": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "products": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["productId"],
        "properties": {
          "productId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "shopName": {
            "type": "string", "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          },
          "variantName": {
            "type": "string", "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          }
        }
      }
    }
  }
}
